# PDF Presenter — environment configuration
# Copy this file to `.env` and adjust. Real environment variables take precedence.

# HTTP port and bind address
PORT=3000
HOST=0.0.0.0

# development | production
NODE_ENV=production

# silent | error | warn | info | debug  (default: info in production, debug otherwise)
LOG_LEVEL=info

# Hours a session may stay idle with no presenter connected before it is removed (default: 4)
SESSION_TTL=4

# Maximum PDF upload size in MB (default: 100)
MAX_FILE_SIZE=100

# Session-creation rate limit per client IP: window in minutes and max sessions per window
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20

# Set when running behind a reverse proxy (nginx, Caddy, a PaaS router):
#   1 = trust one proxy hop. Leave unset when clients connect directly.
# TRUST_PROXY=1

# Storage locations (relative to the project root or absolute)
# UPLOAD_DIR=uploads
# DATA_DIR=data
